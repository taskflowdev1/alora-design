#!/usr/bin/env bash
# jobq: portable (scripts/env.sh installs deps + browser; read-only checks against local preview servers)
# Build, then capture the landing bento review shots into output/review-v3/. Run through the job queue.
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/env.sh
npx vite build --logLevel warn
node scripts/landing-shots.mjs 2>&1 | tee "${TMPDIR:-/tmp}/landing-shots.log"
