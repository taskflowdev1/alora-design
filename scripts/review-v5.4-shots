#!/usr/bin/env bash
# jobq: portable (scripts/env.sh installs deps + browser; builds the working tree and shoots it next to the live site)
# v5.4 review shots into output/review-v5.4/: before (the live site, or BEFORE=<url>) | after (this tree), with classic
# scrollbars: the Orders toolbar tile, the carousel card, the Chat band, the landing's right edge at 1440 and 1720
# (flap closed and open, both themes), the Display band without the typography card, the Sales row, /components Display.
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/env.sh
OUT="${OUT:-output/review-v5.4}"
WORK="${TMPDIR:-/tmp}/review-v54"
rm -rf "$WORK" && mkdir -p "$WORK" "$OUT"
npx vite build --logLevel warn --outDir "$WORK/dist" --emptyOutDir
DIST="$WORK/dist" OUT="$OUT" node scripts/review-v5.4-shots.mjs 2>&1 | tee "${TMPDIR:-/tmp}/review-v54-shots.log"
