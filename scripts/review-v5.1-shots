#!/usr/bin/env bash
# jobq: portable (scripts/env.sh installs deps + browser; builds three local versions and shoots them headless)
# v5.1 review shots into output/review-v5.1/: original (e449e2c), v5 (6d4be3a) and the working tree, side by side.
# The two older versions come from `git archive` tarballs in .review-src/. A synced (Mac) job has no .git, so make them
# before submitting: `mkdir -p .review-src && for v in e449e2c 6d4be3a; do git archive $v -o .review-src/$v.tar; done`
# (delete the folder after; never commit it). On Yoga the script makes them itself. ONLY=<regex> limits by letter.
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/env.sh
ROOT="$PWD"
WORK="${TMPDIR:-/tmp}/review-v51"
rm -rf "$WORK" && mkdir -p "$WORK"
npx vite build --logLevel warn --outDir "$WORK/dist-new" --emptyOutDir
mkdir -p .review-src
for v in e449e2c 6d4be3a; do
  if [ ! -f ".review-src/$v.tar" ]; then
    git archive "$v" -o ".review-src/$v.tar" 2>/dev/null || { echo "missing .review-src/$v.tar"; exit 1; }
  fi
  mkdir -p "$WORK/src-$v" && tar -xf ".review-src/$v.tar" -C "$WORK/src-$v"
  ln -s "$ROOT/node_modules" "$WORK/src-$v/node_modules"
  (cd "$WORK/src-$v" && npx vite build --logLevel warn --outDir "$WORK/dist-$v" --emptyOutDir)
done
WORK="$WORK" node scripts/review-v5.1-shots.mjs 2>&1 | tee "${TMPDIR:-/tmp}/review-v51-shots.log"
