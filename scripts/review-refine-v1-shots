#!/usr/bin/env bash
# jobq: portable (scripts/env.sh installs deps + browser; builds BEFORE_REF from git, or a public clone when the frozen copy has no .git)
# Refine v1 shots into output/refine-v1/: before (BEFORE_REF, default 52b9cd4) | after (this tree), built in the same job,
# desktop 1440x900 and phone 390x844, dark and light. SKIP_BEFORE=1 shoots only this tree; ONLY=<regex> filters by name.
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/env.sh
# `explore`: this tree only, into output/refine-v1-explore (a quick look while working).
if [ "${1:-}" = explore ]; then SKIP_BEFORE=1; OUT=output/refine-v1-explore; fi
OUT="${OUT:-output/refine-v1}"
REF="${BEFORE_REF:-52b9cd4}"
WORK="${TMPDIR:-/tmp}/refine-v1"
rm -rf "$WORK" && mkdir -p "$WORK/before" "$OUT"
npx vite build --logLevel warn --outDir "$WORK/dist-after" --emptyOutDir
if [ "${SKIP_BEFORE:-0}" != 1 ]; then
  if git rev-parse -q --verify "$REF^{commit}" >/dev/null 2>&1; then
    git archive "$REF" | tar -x -C "$WORK/before"
  else
    git clone -q --filter=blob:none --no-checkout https://github.com/taskflowdev1/alora-design "$WORK/clone"
    git -C "$WORK/clone" archive "$REF" | tar -x -C "$WORK/before"
  fi
  ln -s "$PWD/node_modules" "$WORK/before/node_modules"
  (cd "$WORK/before" && npx vite build --logLevel warn --outDir "$WORK/dist-before" --emptyOutDir)
fi
BEFORE_DIST="$([ "${SKIP_BEFORE:-0}" = 1 ] || echo "$WORK/dist-before")" AFTER_DIST="$WORK/dist-after" REF="$REF" OUT="$OUT" \
  node scripts/review-refine-v1-shots.mjs 2>&1 | tee "$WORK/shots.log"
