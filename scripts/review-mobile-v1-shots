#!/usr/bin/env bash
# jobq: portable (scripts/env.sh installs deps + browser; builds BEFORE_REF from git and this tree, shoots both locally)
# Mobile v1 shots: output/mobile-v1/ (M letters: mobile components + example app, dark | light; N letters: nav split).
# Needs git (the before build comes from `git archive $BEFORE_REF`), so run it on Yoga without --sync. ONLY="M1|N2".
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/env.sh
BEFORE_REF="${BEFORE_REF:-92ee184}"
WORK="${TMPDIR:-/tmp}/review-mobile1"
rm -rf "$WORK" && mkdir -p "$WORK/before-src"
if [ -z "${SKIP_BEFORE:-}" ]; then
  git archive "$BEFORE_REF" | tar -x -C "$WORK/before-src"
  ln -s "$PWD/node_modules" "$WORK/before-src/node_modules"
  (cd "$WORK/before-src" && npx vite build --logLevel warn --outDir "$WORK/before" --emptyOutDir)
  export BEFORE_DIST="$WORK/before"
fi
npx vite build --logLevel warn --outDir "$WORK/after" --emptyOutDir
BEFORE_REF="$BEFORE_REF" AFTER_DIST="$WORK/after" node scripts/review-mobile-v1-shots.mjs 2>&1 | tee "$WORK/shots.log"
