#!/usr/bin/env bash
# jobq: portable (scripts/env.sh installs deps + browser; read-only checks against local preview servers)
# The one gate: typecheck, unit, lint, docs drift (README + docs/components.md), grey ramp, dead exports, build, headless
# smoke on a free port. Static checks first, side by side; stops at the first failing stage. Heavy: run it as a background job (see AGENTS.md).
#   ./scripts/verify                   full: every step and every smoke section. Required before a large release.
#   ./scripts/verify --changed [base]  localized: every static check and the build, then only the smoke sections that
#                                      reach files changed since base (default origin/main). Shared code or config
#                                      widens to full; documentation alone skips the build and browser.
#   ./scripts/verify --only <step>     one step (smoke builds first)
# No step reads a cache, so a pass always means the check ran on this code.
# A failure ends with one line: GATE FAIL alora-design-verify: <step> | log: <path> | rerun: <command>
set -uo pipefail
cd "$(dirname "$0")/.."
steps=(typecheck unit lint docs greys knip build smoke)
usage() { echo "usage: $0 [--changed [base] | --only <step>], steps: ${steps[*]}" >&2; exit 2; }
only=
changed=0
base=
case "${1:-}" in
  "") ;;
  --only)
    only=${2:-} known=0
    for step in "${steps[@]}"; do [ "$step" != "$only" ] || known=1; done
    [ "$known" = 1 ] && [ $# -eq 2 ] || usage ;;
  --changed)
    changed=1 base=${2:-}
    [ $# -le 2 ] || usage
    case "$base" in -*) usage ;; esac ;;
  *) usage ;;
esac
if [ -n "$only" ]; then
  case $only in
    smoke) steps=(build smoke) ;;
    build) steps=(build); NEEDS_BROWSER=0 ;;
    *) steps=("$only"); NEEDS_BROWSER=0 ;;
  esac
fi
logs=$(mktemp -d "${TMPDIR:-/tmp}/alora-design-verify.XXXXXX")
# The queue keeps a failed job's $TMPDIR logs on Yoga; a Mac job's output is in its job log.
where() {
  if [ -z "${JOBQ_ID:-}" ]; then echo "$1"
  elif [ "${JOBQ_HOST:-}" = mac ]; then echo "job log $JOBQ_ID"
  else echo "${JOBQ_STATE:-$HOME/.local/state/jobq}/logs/$JOBQ_ID-$JOBQ_ATTEMPT.files/${1#"$TMPDIR"/}"; fi
}
# Setup runs once on its own so a failed install gets the same last line; then this shell takes its Node.
export NEEDS_BROWSER="${NEEDS_BROWSER:-1}"
bash -c 'set -e; . scripts/env.sh' > "$logs/setup.log" 2>&1
setup=$?
if [ "$setup" -ne 0 ]; then
  tail -n 25 "$logs/setup.log"
  echo "GATE FAIL alora-design-verify: setup | log: $(where "$logs/setup.log") | rerun: npm ci --no-audit --no-fund"
  exit 1
fi
NEEDS_BROWSER=0 . scripts/env.sh
set +e # env.sh turns it on; each step's status is read below.
export SITE_DIST="${TMPDIR:-/tmp}/alora-design-verify-site-$$"
trap 'rm -rf "$SITE_DIST"' EXIT

unset SMOKE_SECTIONS
label=full
if [ "$changed" = 1 ]; then
  if ! scope=$(node scripts/changed.mjs ${base:+"$base"}); then
    echo "GATE FAIL alora-design-verify: changed-file scope | log: stderr above | rerun: ./scripts/verify"
    exit 1
  fi
  IFS=$'\t' read -r kind sections reason <<< "$scope"
  echo "== scope: $kind ($reason)"
  case $kind in
    full) ;;
    docs) steps=(typecheck unit lint docs greys knip); label="localized, documentation only" ;;
    sections) export SMOKE_SECTIONS="$sections"; label="localized, $reason" ;;
    *) echo "GATE FAIL alora-design-verify: changed-file scope ($scope) | log: none | rerun: ./scripts/verify"; exit 1 ;;
  esac
fi

run() {
  case $1 in
    typecheck) npx tsc -p tsconfig.json --noEmit ;;
    unit) node scripts/unit.mjs ;;
    lint) npx eslint . ;;
    docs) node scripts/gen-docs.mjs --check ;;
    greys) node scripts/greys.mjs --check ;;
    knip) npx knip --no-progress ;;
    build) npx vite build --logLevel warn --outDir "$SITE_DIST" --emptyOutDir ;;
    smoke) node scripts/smoke.mjs ;;
  esac
}
fail() {
  local step=$1 name=$1 first more
  if [ "$step" = smoke ]; then
    # The first failed check, without its measurements.
    first=$(grep -m1 '^FAIL ' "$logs/smoke.log" | sed -E 's/^FAIL //; s/ \(.*//' | cut -c1-70)
    more=$(($(grep -c '^FAIL ' "$logs/smoke.log") - 1))
    if [ -n "$first" ]; then name="smoke: $first"; [ "$more" -le 0 ] || name="$name (+$more more)"
    else name="smoke: crashed before its summary"; fi
  fi
  echo "GATE FAIL alora-design-verify: $name | log: $(where "$logs/$step.log") | rerun: ./scripts/verify --only $step"
  exit 1
}
wanted() { local s; for s in "${steps[@]}"; do [ "$s" != "$1" ] || return 0; done; return 1; }
# The static checks run side by side (about 1.9 GiB together, no more than the browser step). Their logs print in order,
# and the first failure in that order ends the run before the build.
for group in "typecheck unit lint docs greys knip" build smoke; do
  members=()
  for step in $group; do wanted "$step" && members+=("$step"); done
  [ "${#members[@]}" -gt 0 ] || continue
  if [ "${#members[@]}" -eq 1 ]; then
    step=${members[0]}
    echo "== $step"
    run "$step" 2>&1 | tee "$logs/$step.log"
    [ "${PIPESTATUS[0]}" -eq 0 ] || fail "$step"
    continue
  fi
  pids=()
  for step in "${members[@]}"; do
    run "$step" > "$logs/$step.log" 2>&1 &
    pids+=($!)
  done
  failed=
  for i in "${!members[@]}"; do
    wait "${pids[$i]}"
    status=$?
    echo "== ${members[$i]}"
    cat "$logs/${members[$i]}.log"
    [ "$status" -eq 0 ] || [ -n "$failed" ] || failed=${members[$i]}
  done
  [ -z "$failed" ] || fail "$failed"
done
if [ "$label" = full ]; then echo "VERIFY PASS"; else echo "VERIFY PASS ($label; not a release gate)"; fi
