#!/usr/bin/env bash
# Typecheck, lint, build, headless smoke on its own port. Cheapest first; stops at the first failure.
# Heavy: run through the job queue (see AGENTS.md).
set -euo pipefail
cd "$(dirname "$0")/.."
[ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null
step() { echo "== $1"; }
step typecheck; npx tsc -p tsconfig.json --noEmit
step lint; npx eslint .
step build; npx vite build --logLevel warn
step smoke; node scripts/smoke.mjs
echo "VERIFY PASS"
