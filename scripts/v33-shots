#!/usr/bin/env bash
# jobq: portable (scripts/env.sh installs deps + browser; read-only checks against local preview servers)
# Build, capture the v3.3 review (logo header before/after, hero at 360–1440, flap/popover scroll isolation) into
# output/review-v3.3/, then run the smoke test. Run through the job queue.
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/env.sh
npx vite build --logLevel warn
BEFORE_BASE="${BEFORE_BASE-https://design.alorawork.com}" node scripts/v33-shots.mjs 2>&1 | tee "${TMPDIR:-/tmp}/v33-shots.log"
node scripts/smoke.mjs 2>&1 | tee -a "${TMPDIR:-/tmp}/v33-shots.log"
