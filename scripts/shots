#!/usr/bin/env bash
# jobq: portable (scripts/env.sh installs deps + browser; read-only checks against local preview servers)
# Build, then capture per-component review screenshots + automatic taste checks (borders, fonts, hover shifts) into output/review-v2/. Run through the job queue.
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/env.sh
npx vite build --logLevel warn
node scripts/shots.mjs
