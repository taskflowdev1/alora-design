#!/usr/bin/env bash
# jobq: portable (scripts/env.sh installs deps + browser; read-only checks against local preview servers)
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/env.sh
SITE_DIST="$(mktemp -d "${TMPDIR:-/tmp}/ad-shots.XXXXXX")"
trap 'rm -rf "$SITE_DIST"' EXIT
npx vite build --logLevel warn --outDir "$SITE_DIST" --emptyOutDir
SITE_DIST="$SITE_DIST" node scripts/shots.mjs
