#!/usr/bin/env bash
# jobq: portable (scripts/env.sh installs deps + browser; read-only checks against local preview servers)
# Build, then capture review screenshots + automatic checks into output/review/. Run through the job queue.
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/env.sh
npx vite build --logLevel warn
node scripts/shots.mjs
