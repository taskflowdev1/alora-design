#!/usr/bin/env bash
# jobq: portable (scripts/env.sh installs deps + browser; builds the working tree and shoots it next to the live site)
# v6.0 review shots into output/review-v6.0/: before (the live site) | after (this tree): the one-time code: every state, both themes, plus a short video.
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/env.sh
OUT="${OUT:-output/review-v6.0}"
WORK="${TMPDIR:-/tmp}/review-v60"
rm -rf "$WORK" && mkdir -p "$WORK" "$OUT"
npx vite build --logLevel warn --outDir "$WORK/dist" --emptyOutDir
DIST="$WORK/dist" OUT="$OUT" node scripts/review-v6.0-shots.mjs 2>&1 | tee "${TMPDIR:-/tmp}/review-v60-shots.log"
# The video: crop to the till card and make an mp4 (ffmpeg on the host when present).
V="$OUT/video"; W=$(ls "$V"/*.webm 2>/dev/null | head -1)
if [ -n "$W" ] && command -v ffmpeg >/dev/null; then
  read -r X Y BW BH < <(node -e 'const b=require(process.argv[1]);const e=(n)=>Math.round(n/2)*2;console.log(e(b.x-24),e(b.y-24),e(b.width+48),e(b.height+48))' "$PWD/$V/box.json")
  ffmpeg -y -loglevel error -i "$W" -vf "crop=$BW:$BH:$X:$Y" -c:v libx264 -pix_fmt yuv420p -movflags +faststart "$OUT/V-otp-flow.mp4" && rm -f "$W"
fi
