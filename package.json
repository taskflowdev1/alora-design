{
  "name": "alora-design",
  "private": true,
  "version": "0.1.0",
  "description": "Copy-paste React components for dense ERP and admin apps, shadcn style, themed by one URL config.",
  "license": "MIT",
  "homepage": "https://design.alorawork.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taskflowdev1/alora-design.git"
  },
  "bugs": {
    "url": "https://github.com/taskflowdev1/alora-design/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "comments": "node scripts/comment-check/check.mjs --all",
    "preview": "vite preview",
    "unit": "node scripts/unit.mjs",
    "docs": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check",
    "greys": "node scripts/greys.mjs --check",
    "knip": "knip",
    "smoke": "node scripts/smoke.mjs",
    "verify": "./scripts/verify",
    "verify:changed": "./scripts/verify --changed"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-feather": "^2.0.10",
    "react-router": "^7.18.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
